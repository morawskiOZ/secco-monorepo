{
	"name": "secco-studio",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run worker/test",
		"check:worker": "tsc -p worker/tsconfig.json",
		"dev:worker": "wrangler dev --env staging",
		"deploy:staging": "wrangler deploy --env staging",
		"deploy": "wrangler deploy --env=\"\""
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261125.1",
		"@sveltejs/adapter-static": "^3.0.0",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"svelte": "^5.51.0",
		"svelte-check": "^4.4.2",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vitest": "^5.1.2",
		"wrangler": "^4.168.0"
	},
	"allowScripts": {
		"workerd@1.20261123.1": true,
		"esbuild@0.27.4": true,
		"esbuild@0.28.2": true
	}
}
